# Copy to .env next to docker-compose.yml and set these to your own paths.
# Nothing in this file is machine-specific: the compose file only uses these names.

# Read-only mount point for weights, quantisation packs, MTP head and expert profile.
# Inside the container everything below appears as /models (see config/strata-final.json).
STRATA_MODEL_DIR=/srv/models

# Directory holding strata-final.json; mounted read-only at /config.
STRATA_CONFIG_DIR=./config

# Writable directory for session snapshots and autosave files.
# These files contain live conversation KV state -- keep them out of backups you share.
STRATA_SESSION_DIR=./sessions

# Autosave loop in the entrypoint.
AUTOSAVE_INTERVAL=900      # seconds between snapshots of slot 0
AUTOSAVE_KEEP=4            # rotating copies: autosave-0.bin .. autosave-3.bin
AUTOSAVE_RESTORE=1         # 1 = restore the newest snapshot once the API answers
